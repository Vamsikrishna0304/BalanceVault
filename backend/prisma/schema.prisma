
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ACCOUNT_HOLDER
}

enum AccountStatus {
  PENDING
  ACTIVE
  FROZEN
  CLOSED
}

enum TransferStatus {
  PENDING
  COMPLETED
  FAILED
}

enum EntryType {
  DEBIT
  CREDIT
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String
  email        String    @unique
  passwordHash String
  role         UserRole  @default(ACCOUNT_HOLDER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  accounts       Account[]
  idempotencyKeys IdempotencyKey[]
  auditLogs      AuditLog[]
}

model Account {
  id            String        @id @default(uuid()) @db.Uuid
  accountNumber String        @unique
  ownerId       String        @db.Uuid
  balance       Decimal       @default(0) @db.Decimal(18, 2)
  currency      String        @default("INR")
  status        AccountStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  owner           User          @relation(fields: [ownerId], references: [id])
  outgoingTransfers Transfer[]  @relation("FromAccount")
  incomingTransfers Transfer[]  @relation("ToAccount")
  ledgerEntries    LedgerEntry[]

  @@index([ownerId])
}

model Transfer {
  id              String         @id @default(uuid()) @db.Uuid
  fromAccountId   String         @db.Uuid
  toAccountId     String         @db.Uuid
  amount          Decimal        @db.Decimal(18, 2)
  currency        String         @default("INR")
  status          TransferStatus @default(PENDING)
  description     String?
  createdAt       DateTime       @default(now())

  fromAccount Account @relation("FromAccount", fields: [fromAccountId], references: [id])
  toAccount   Account @relation("ToAccount", fields: [toAccountId], references: [id])
  ledgerEntries LedgerEntry[]

  @@index([fromAccountId])
  @@index([toAccountId])
}

model LedgerEntry {
  id         String    @id @default(uuid()) @db.Uuid
  transferId String    @db.Uuid
  accountId  String    @db.Uuid
  entryType  EntryType
  amount     Decimal   @db.Decimal(18, 2)
  createdAt  DateTime  @default(now())

  transfer Transfer @relation(fields: [transferId], references: [id])
  account  Account  @relation(fields: [accountId], references: [id])

  @@index([transferId])
  @@index([accountId])
}

model IdempotencyKey {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  key       String
  requestHash String
  response  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, key])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
